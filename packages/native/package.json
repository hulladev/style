{
  "name": "@hulla/style-native",
  "version": "1.0.0",
  "description": "Typed React Native style composition and variants for the @hulla/style ecosystem",
  "author": "Samuel Hulla <hulla@hulla.dev>",
  "homepage": "https://hulla.dev/docs/style/native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/style.git",
    "directory": "packages/native"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/es/index.d.mts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/es/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint src tests",
    "build": "bunchee -m",
    "test": "vitest run tests/index.test.ts && pnpm run test:types",
    "test:types": "pnpm --dir ../.. exec tsc -p packages/native/tsconfig.types.json --noEmit"
  },
  "peerDependencies": {
    "@hulla/style": "workspace:^",
    "react-native": ">=0.81.0 <1.0.0"
  },
  "devDependencies": {
    "@hulla/style": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
